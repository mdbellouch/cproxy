def menu():
    mgr = ProxyManager()
    while True:
        banner()
        print(f"{B}[1]{E} {G}Power On{E}      {B}[2]{E} {R}Power Off{E}     {B}[3]{E} {C}Status{E}")
        print(f"{B}[4]{E} Manual Setup  {B}[5]{E} Save Profile  {B}[6]{E} Load Profile")
        print(f"{B}[7]{E} Exit")
        
        choice = input(f"\n{G}mdbellouch@cproxy:{C}~/menu${E} ")

        if choice == '1': mgr.toggle(True)
        elif choice == '2': mgr.toggle(False)
        elif choice == '3': mgr.show_status()
        elif choice == '4':
            host = input(f"{C}Host: {E}")
            port = input(f"{C}Port: {E}")
            ptype = input(f"{C}Type (http/socks) [http]: {E}") or "http"
            user = input(f"{C}User: {E}")
            pw = input(f"{C}Pass: {E}") if user else None
            mgr.apply_settings(host, port, ptype, user, pw)
        elif choice == '5':
            name = input(f"{Y}Profile Name: {E}")
            host = input(f"{C}Host: {E}")
            port = input(f"{C}Port: {E}")
            ptype = input(f"{C}Type: {E}")
            user = input(f"{C}User: {E}")
            pw = input(f"{C}Pass: {E}") if user else None
            mgr.profiles[name] = {"host": host, "port": port, "type": ptype, "user": user, "pass": pw}
            mgr._save_profiles()
        elif choice == '6':
            for p in mgr.profiles.keys(): print(f" {G}>>{E} {p}")
            name = input(f"\n{Y}Select Profile: {E}")
            if name in mgr.profiles:
                p = mgr.profiles[name]
                mgr.apply_settings(p['host'], p['port'], p['type'], p.get('user'), p.get('pass'))
        elif choice == '7': break
        
        input(f"\n{B}Press [Enter] to return...{E}")
        clear()

if __name__ == "__main__":
    try:
        clear()
        menu()
    except KeyboardInterrupt:
        sys.exit()