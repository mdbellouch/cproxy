import subprocess
import json
import os
import sys

# --- ANSI COLORS ---
G = '\033[92m'  # Green
Y = '\033[93m'  # Yellow
R = '\033[91m'  # Red
C = '\033[96m'  # Cyan
B = '\033[1m'   # Bold
E = '\033[0m'   # End

CONFIG_DIR = os.path.expanduser("~/.config/cosmic-proxy")
PROFILES_FILE = os.path.join(CONFIG_DIR, "profiles.json")

class ProxyManager:
    def __init__(self):
        if not os.path.exists(CONFIG_DIR):
            os.makedirs(CONFIG_DIR, mode=0o700, exist_ok=True)
        self.profiles = self._load_profiles()

    def _load_profiles(self):
        if os.path.exists(PROFILES_FILE):
            with open(PROFILES_FILE, 'r') as f:
                return json.load(f)
        return {}

    def _save_profiles(self):
        with open(PROFILES_FILE, 'w') as f:
            json.dump(self.profiles, f, indent=4)
        os.chmod(PROFILES_FILE, 0o600)

    def run_cmd(self, cmd):
        try:
            subprocess.run(cmd, shell=True, check=True, capture_output=True)
        except subprocess.CalledProcessError:
            print(f"{R}[!] Fatal: System settings rejected the command.{E}")

    def get_setting(self, schema, key):
        try:
            res = subprocess.run(f"gsettings get {schema} {key}", shell=True, capture_output=True, text=True, check=True)
            return res.stdout.strip().strip("'")
        except subprocess.CalledProcessError:
            return "Unknown"

    def show_status(self):
        mode = self.get_setting("org.gnome.system.proxy", "mode")
        http_host = self.get_setting("org.gnome.system.proxy.http", "host")
        http_port = self.get_setting("org.gnome.system.proxy.http", "port")
        socks_host = self.get_setting("org.gnome.system.proxy.socks", "host")
        socks_port = self.get_setting("org.gnome.system.proxy.socks", "port")

        print(f"\n{B}{C}=== LIVE SYSTEM STATUS ==={E}")
        if mode == "manual":
            print(f"{B}State:{E} {G}[ ACTIVE ]{E}")
            print(f" {Y}>>{E} HTTP:  {http_host}:{http_port}")
            print(f" {Y}>>{E} SOCKS: {socks_host}:{socks_port}")
        elif mode == "none":
            print(f"{B}State:{E} {R}[ OFFLINE ]{E}")
        else:
            print(f"{B}State:{E} {Y}[ {mode.upper()} ]{E}")

    def toggle(self, status):
        mode = "manual" if status else "none"
        self.run_cmd(f"gsettings set org.gnome.system.proxy mode '{mode}'")
        state = f"{G}ENABLED{E}" if status else f"{R}DISABLED{E}"
        print(f"\n{B}System Status:{E} Proxy is now {state}")

    def apply_settings(self, host, port, p_type, user=None, password=None):
        if p_type == "http":
            schema = "org.gnome.system.proxy.http"
            self.run_cmd(f"gsettings set {schema} host '{host}'")
            self.run_cmd(f"gsettings set {schema} port {port}")
            if user and password:
                self.run_cmd(f"gsettings set {schema} use-authentication true")
                self.run_cmd(f"gsettings set {schema} authentication-user '{user}'")
                self.run_cmd(f"gsettings set {schema} authentication-password '{password}'")
            else:
                self.run_cmd(f"gsettings set {schema} use-authentication false")
            self.run_cmd(f"gsettings set org.gnome.system.proxy.https host '{host}'")
            self.run_cmd(f"gsettings set org.gnome.system.proxy.https port {port}")
        else:
            self.run_cmd(f"gsettings set org.gnome.system.proxy.socks host '{host}'")
            self.run_cmd(f"gsettings set org.gnome.system.proxy.socks port {port}")
        self.toggle(True)

